            steps {
                git branch: 'master',
                    url: 'https://github.com/azuredevops7/maven-project.git'
            }
        }
        stage('sonarqube') {
            steps {
               sh '''
               mvn sonar:sonar \
                 -Dsonar.projectKey=maven \
