        }
        stage ('Tag') {
            steps {
                sh 'docker tag testsah:latest 800373800709.dkr.ecr.us-east-1.amazonaws.com/testsah:latest'
            }
        }
        stage ('Push') {
            steps {
                sh 'docker push 800373800709.dkr.ecr.us-east-1.amazonaws.com/testsah:latest'
            }
        }
        stage ('Deploy') {
            steps {
                sh 'kubectl apply -f deployment.yml'
            }
        }
    }
}
